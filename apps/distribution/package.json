{
  "name": "@koda/distribution-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "koda": "./dist/main.js",
    "koda-chat": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koda/app-server": "workspace:*",
    "@koda/cli": "workspace:*",
    "@koda/distribution": "workspace:*",
    "@koda/protocol": "workspace:*",
    "@koda/tui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0"
  }
}
