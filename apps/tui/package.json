{
  "name": "@koda/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "koda-chat": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koda/app-server-client-node": "workspace:*",
    "@koda/distribution": "workspace:*",
    "@koda/protocol": "workspace:*",
    "commander": "^15.0.0",
    "ink": "7.1.1",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0"
  }
}
