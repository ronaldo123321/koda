{
  "name": "koda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "pnpm build:native && pnpm -r --if-present build",
    "build:native": "cargo build --workspace",
    "chat": "node apps/tui/dist/main.js",
    "eval:scenarios": "pnpm build && vitest run packages/testkit/scenarios/scenario-suite.test.ts",
    "format": "cargo fmt --all && prettier --write .",
    "format:check": "cargo fmt --all -- --check && prettier --check .",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm build && pnpm test:native && vitest run",
    "test:native": "cargo test --workspace",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
