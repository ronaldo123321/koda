  "redaction_cases": [
    {
      "name": "secret split across chunks",
      "secrets_base64": ["YWxwaGEtc2VjcmV0LXZhbHVl"],
      "chunks_base64": ["cHJlZml4IGFscGhhLQ==", "c2VjcmV0LXZhbHVlIHN1ZmZpeA=="],
      "expected_base64": "cHJlZml4IFtSRURBQ1RFRF0gc3VmZml4",
      "replacements": 1
    },
    {
      "name": "longest overlapping value wins",
      "secrets_base64": ["YWJjZGVmZ2g=", "YWJjZGVmZ2hpag=="],
      "chunks_base64": ["eGFiY2Rl", "ZmdoaWp5YWJjZGVmZ2h6"],
      "expected_base64": "eFtSRURBQ1RFRF15W1JFREFDVEVEXXo=",
      "replacements": 2
    },
    {
      "name": "duplicate adjacent values redact once per position",
      "secrets_base64": ["cmVwZWF0LXNlY3JldA==", "cmVwZWF0LXNlY3JldA=="],
      "chunks_base64": ["cmVwZWF0LXNlY3JldHJlcGVhdC1zZWNyZXQ="],
      "expected_base64": "W1JFREFDVEVEXVtSRURBQ1RFRF0=",
      "replacements": 2
    },
    {
      "name": "UTF-8 secret splits inside a code point",
      "secrets_base64": ["5py65a+G5Luk54mM5YC8LTIwMjY="],
      "chunks_base64": ["5YmN57yA5py65a8=", "huS7pOeJjOWAvC0yMDI25ZCO57yA"],
      "expected_base64": "5YmN57yAW1JFREFDVEVEXeWQjue8gA==",
      "replacements": 1
    },
    {
      "name": "binary output remains byte exact",
      "secrets_base64": ["YWxwaGEtc2VjcmV0LXZhbHVl"],
      "chunks_base64": ["AP8=", "YWxwaGEtc2VjcmV0LXZhbHVl", "/gE="],
      "expected_base64": "AP9bUkVEQUNURURd/gE=",
      "replacements": 1
    },
    {
      "name": "literal replacement marker is unchanged",
      "secrets_base64": ["YWxwaGEtc2VjcmV0LXZhbHVl"],
      "chunks_base64": ["cHJlZml4IFtSRURBQ1RFRF0gc3VmZml4"],
      "expected_base64": "cHJlZml4IFtSRURBQ1RFRF0gc3VmZml4",
      "replacements": 0
    },
    {
      "name": "output limit applies after redaction",
      "secrets_base64": ["bGltaXQtc2VjcmV0LXZhbHVl"],
      "chunks_base64": ["MTIzNDVsaW1pdC0=", "c2VjcmV0LXZhbHVlNjc4OTA="],
      "expected_base64": "MTIzNDVbUkVEQUNURURdNjc4OTA=",
      "replacements": 1,
      "output_limit_bytes": 15,
      "expected_limited_base64": "MTIzNDVbUkVEQUNURURd"
    },
    {
      "name": "empty secret set is pass-through",
      "secrets_base64": [],
      "chunks_base64": ["AP8=", "/gE="],
      "expected_base64": "AP/+AQ==",
      "replacements": 0
    }
  ]
